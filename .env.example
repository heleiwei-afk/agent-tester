# ============================================
# AgentTester 环境变量配置
# ============================================

# --- 数据库 ---
DATABASE_PATH=./data/agent-tester.db

# --- Redis（BullMQ 队列） ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- LLM 配置（用例生成 + 评估判分） ---
# 支持 OpenAI 兼容接口，可配置为 DeepSeek/Claude/本地模型
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat

# --- 阿里百炼配置 ---
# 用于测试时调用智能体
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_APP_ID=your_app_id_here

# --- Coze 国内版配置（Phase 2） ---
# COZE_CN_API_KEY=pat_xxx
# COZE_CN_BOT_ID=xxx

# --- Coze 国际版配置（Phase 2） ---
# COZE_GLOBAL_API_KEY=pat_xxx
# COZE_GLOBAL_BOT_ID=xxx

# --- 执行配置 ---
# 最大并发执行数（Coze 可设 10，百炼建议 ≤ 5）
MAX_CONCURRENCY=10
# 单条用例默认超时（秒）
DEFAULT_TIMEOUT_SEC=30
# 默认重试次数
DEFAULT_RETRY_COUNT=2

# --- 可选：Sentry（Phase 3） ---
# SENTRY_DSN=

# --- 应用配置 ---
NODE_ENV=development
PORT=3000
